# Server
PORT=3000

# Database (postgres in dev/prod; DB_TYPE=sqljs selects in-memory sqlite for tests)
DB_TYPE=postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kazora

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=dev-only-secret
JWT_EXPIRES_IN=7d

# Storage
UPLOAD_DIR=./uploads
PUBLIC_URL=http://localhost:3000
